# 백엔드 환경변수 — 실제 값은 .env 로 복사해서 채운다. .env 는 커밋 금지.

# GPT API (OpenAI 호환). Codyssey 게이트웨이를 쓰면 BASE_URL 을 지정한다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_TOKENS=700

# Firestore. 서비스 계정 JSON 의 "파일 경로" 또는 JSON 문자열 그대로.
# 비워 두면 로컬 JSON 저장소(STORE_PATH)로 동작한다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS 허용 오리진(콤마 구분). 프론트를 Vercel 에 올리면 그 도메인을 넣는다.
ALLOWED_ORIGINS=*

# 로컬 저장소 경로(Firestore 미사용 시)
STORE_PATH=var/db.json
SEED_PATH=data/seed.json
